{
  "name": "day-one-content-operations",
  "private": true,
  "version": "1.0.0",
  "description": "Day One Content Operations",
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "build": "npm-run-all --parallel build:*",
    "dev:web": "npm run dev -w apps/web",
    "dev:studio": "npm run dev -w apps/studio-hello-world",
    "predev": "npm run typegen --enforce-required-fields",
    "prebuild": "npm run typegen --enforce-required-fields",
    "typegen": "sanity schema extract && sanity typegen generate --enforce-required-fields"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "next-sanity": "^11.6.2"
  }
}
